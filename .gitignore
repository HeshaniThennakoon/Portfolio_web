# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js & Builds
/.next/
/out/
/build
/dist

# Misc & OS Files
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
Desktop.ini

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment Files (Keep secrets safe, allow example template)
.env*
!.env.example

# Vercel & Deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# Prisma & Local Databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Dynamic User Uploads & Generated Assets
/public/profile-*
/public/about-profile-*
/public/uploads/*
!/public/uploads/.gitkeep
