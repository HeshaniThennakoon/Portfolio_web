datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Settings {
  id             Int    @id @default(1)
  primaryColor   String @default("#2563EB")
  secondaryColor String @default("#06B6D4")
  accentColor    String @default("#8B5CF6")
  darkBg         String @default("#0F172A")
  lightBg        String @default("#F8FAFC")
  
  username       String @default("admin")
  passwordHash   String 
  
  smtpHost       String @default("smtp.gmail.com")
  smtpPort       Int    @default(465)
  smtpUser       String @default("thennakoonghm@gmail.com")
  smtpPass       String @default("")
  toEmail        String @default("thennakoonghm@gmail.com")
}

model HeroInfo {
  id                  Int    @id @default(1)
  name                String @default("Heshani Thennakoon")
  headline            String 
  subheadline         String 
  roles               String 
  stats               String 
  resumeUrl           String @default("/resume.pdf")
  profileImg          String @default("/profile.jpg")
  availabilityStatus  String @default("open")
  availabilityMessage String @default("Open to full-time opportunities")
}

model AboutInfo {
  id           Int    @id @default(1)
  story        String 
  highlights   String 
  sectionTitle String @default("Who Am I?")
  sectionBadge String @default("ABOUT ME")
  ctaLabel     String @default("")
  profileImg   String @default("/profile.jpg")
}

model SkillCategory {
  id       String @id @default(uuid())
  category String
  skills   String 
  order    Int    @default(0)
}

model Experience {
  id               String @id @default(uuid())
  role             String
  company          String
  location         String
  period           String
  responsibilities String 
  techStack        String 
  order            Int    @default(0)
}

model Project {
  id           String  @id @default(uuid())
  title        String
  description  String  
  technologies String  
  features     String  
  githubUrl    String  @default("")
  demoUrl      String  @default("")
  imageUrl     String  @default("")
  featured     Boolean @default(false)
  order        Int     @default(0)
  slug         String  @unique @default("")
  role         String  @default("")
  duration     String  @default("")
  teamSize     String  @default("")
  challenge    String  @default("")
  solution     String  @default("")
  outcome      String  @default("")
  screenshots  String  @default("[]")
}

model Education {
  id          String @id @default(uuid())
  degree      String
  institution String
  faculty     String @default("")
  period      String
  focusAreas  String 
  gpa         String @default("")
  achievement String @default("")
  order       Int    @default(0)
}

model Achievements {
  id           Int    @id @default(1)
  leadership   String 
  sports       String 
  professional String 
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   
  createdAt DateTime @default(now())
  replied   Boolean  @default(false)
}

model Service {
  id          String  @id @default(uuid())
  iconName    String  @default("Globe")
  title       String
  description String  
  order       Int     @default(0)
}

model SocialLinks {
  id          Int    @id @default(1)
  email       String @default("")
  phone       String @default("")
  github      String @default("")
  linkedin    String @default("")
  facebook    String @default("")
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  company   String?
  email     String?
  phone     String?
  image     String?
  content   String   
  rating    Int      @default(5)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OgSettings {
  id               Int     @id @default(1)
  tagline          String  @default("Building the Future, One Line at a Time") 
  showAvailability Boolean @default(true)
  showProfilePhoto Boolean @default(true)
  siteName         String  @default("Heshani Thennakoon | Portfolio") 
  siteUrl          String  @default("https://heshani.dev") 
  twitterHandle    String  @default("") 
}
